{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [{ "source": "/agenda.html", "destination": "/tareas?vista=calendario", "permanent": true }],
  "rewrites": [
    { "source": "/habitos", "destination": "/habitos/index.html" },
    { "source": "/habitos/((?!assets/).*)", "destination": "/habitos/index.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
